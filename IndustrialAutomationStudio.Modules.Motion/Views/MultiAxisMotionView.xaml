<UserControl x:Class="IndustrialAutomationStudio.Modules.Motion.Views.MultiAxisMotionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:controls="clr-namespace:IndustrialAutomationStudio.Modules.Motion.Views.Controls"
             xmlns:multiAxis="clr-namespace:IndustrialAutomationStudio.Modules.Motion.ViewModels.MultiAxis"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="MultiAxisDirectionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="68" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource MotionTextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource MotionBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{StaticResource MotionPrimaryLightBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#FF91BAF4" />
                                <Setter Property="Foreground" Value="{StaticResource MotionBrush.Primary}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{StaticResource MotionBrush.Primary}" />
                                <Setter TargetName="Chrome" Property="BorderBrush"
                                        Value="{StaticResource MotionBrush.Primary}" />
                                <Setter Property="Foreground" Value="White" />
                            </DataTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="CompactDirectionButtonTemplate">
            <Button Style="{StaticResource MultiAxisDirectionButtonStyle}"
                    DataContext="{Binding}"
                    IsEnabled="{Binding DataContext.IsNotBusy, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    PreviewMouseLeftButtonDown="DirectionButton_OnPreviewMouseLeftButtonDown"
                    PreviewMouseLeftButtonUp="DirectionButton_OnPreviewMouseLeftButtonUp"
                    LostMouseCapture="DirectionButton_OnLostMouseCapture">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="0,0,10,0" VerticalAlignment="Center"
                               FontFamily="Segoe UI Symbol" FontSize="24"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                               Text="{Binding Symbol}" />
                    <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                               Text="{Binding Label}" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="PlanarJogModuleTemplate">
            <Grid Width="326" Height="280" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="88" />
                    <RowDefinition Height="88" />
                    <RowDefinition Height="88" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="104" />
                    <ColumnDefinition Width="118" />
                    <ColumnDefinition Width="104" />
                </Grid.ColumnDefinitions>

                <Button Grid.Row="0" Grid.Column="1"
                        Margin="8,2" Padding="8,4"
                        Style="{StaticResource MultiAxisDirectionButtonStyle}"
                        DataContext="{Binding Directions[0]}"
                        IsEnabled="{Binding DataContext.IsNotBusy, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        PreviewMouseLeftButtonDown="DirectionButton_OnPreviewMouseLeftButtonDown"
                        PreviewMouseLeftButtonUp="DirectionButton_OnPreviewMouseLeftButtonUp"
                        LostMouseCapture="DirectionButton_OnLostMouseCapture">
                    <StackPanel>
                        <TextBlock HorizontalAlignment="Center" FontFamily="Segoe UI Symbol" FontSize="23"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                   Text="{Binding Symbol}" />
                        <TextBlock Margin="0,3,0,0" HorizontalAlignment="Center" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                   Text="{Binding Label}" />
                    </StackPanel>
                </Button>

                <Button Grid.Row="1" Grid.Column="0"
                        Margin="2,8" Padding="8,4"
                        Style="{StaticResource MultiAxisDirectionButtonStyle}"
                        DataContext="{Binding Directions[1]}"
                        IsEnabled="{Binding DataContext.IsNotBusy, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        PreviewMouseLeftButtonDown="DirectionButton_OnPreviewMouseLeftButtonDown"
                        PreviewMouseLeftButtonUp="DirectionButton_OnPreviewMouseLeftButtonUp"
                        LostMouseCapture="DirectionButton_OnLostMouseCapture">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,8,0" FontFamily="Segoe UI Symbol" FontSize="23"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                   Text="{Binding Symbol}" />
                        <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                   Text="{Binding Label}" />
                    </StackPanel>
                </Button>

                <Grid Grid.Row="1" Grid.Column="1" Width="54" Height="54"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse Stroke="{StaticResource MotionTextSecondaryBrush}" StrokeThickness="1.4" />
                    <Ellipse Width="13" Height="13" Fill="{StaticResource MotionPrimaryLightBrush}"
                             Stroke="{StaticResource MotionTextSecondaryBrush}" StrokeThickness="1" />
                    <Path Stretch="Fill" Stroke="{StaticResource MotionTextSecondaryBrush}" StrokeThickness="1.2"
                          Data="M27,0 L27,14 M27,40 L27,54 M0,27 L14,27 M40,27 L54,27" />
                </Grid>

                <Button Grid.Row="1" Grid.Column="2"
                        Margin="2,8" Padding="8,4"
                        Style="{StaticResource MultiAxisDirectionButtonStyle}"
                        DataContext="{Binding Directions[2]}"
                        IsEnabled="{Binding DataContext.IsNotBusy, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        PreviewMouseLeftButtonDown="DirectionButton_OnPreviewMouseLeftButtonDown"
                        PreviewMouseLeftButtonUp="DirectionButton_OnPreviewMouseLeftButtonUp"
                        LostMouseCapture="DirectionButton_OnLostMouseCapture">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,8,0" FontFamily="Segoe UI Symbol" FontSize="23"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                   Text="{Binding Symbol}" />
                        <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                   Text="{Binding Label}" />
                    </StackPanel>
                </Button>

                <Button Grid.Row="2" Grid.Column="1"
                        Margin="8,2" Padding="8,4"
                        Style="{StaticResource MultiAxisDirectionButtonStyle}"
                        DataContext="{Binding Directions[3]}"
                        IsEnabled="{Binding DataContext.IsNotBusy, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        PreviewMouseLeftButtonDown="DirectionButton_OnPreviewMouseLeftButtonDown"
                        PreviewMouseLeftButtonUp="DirectionButton_OnPreviewMouseLeftButtonUp"
                        LostMouseCapture="DirectionButton_OnLostMouseCapture">
                    <StackPanel>
                        <TextBlock HorizontalAlignment="Center" FontFamily="Segoe UI Symbol" FontSize="23"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                   Text="{Binding Symbol}" />
                        <TextBlock Margin="0,3,0,0" HorizontalAlignment="Center" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                   Text="{Binding Label}" />
                    </StackPanel>
                </Button>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="HorizontalJogModuleTemplate">
            <ItemsControl ItemsSource="{Binding Directions}"
                          ItemTemplate="{StaticResource CompactDirectionButtonTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Margin" Value="6,0" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
            </ItemsControl>
        </DataTemplate>

        <DataTemplate x:Key="VerticalJogModuleTemplate">
            <ItemsControl ItemsSource="{Binding Directions}"
                          ItemTemplate="{StaticResource CompactDirectionButtonTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Margin" Value="0,6" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
            </ItemsControl>
        </DataTemplate>

        <DataTemplate x:Key="RotaryJogModuleTemplate">
            <ItemsControl ItemsSource="{Binding Directions}"
                          ItemTemplate="{StaticResource CompactDirectionButtonTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Margin" Value="0,6" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
            </ItemsControl>
        </DataTemplate>

        <DataTemplate x:Key="JogRegionModuleTemplate">
            <Border Margin="8" Padding="14"
                    Background="Transparent"
                    BorderThickness="0" CornerRadius="10">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Width" Value="172" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static multiAxis:JogModuleKind.Planar}">
                                <Setter Property="Width" Value="374" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static multiAxis:JogModuleKind.LinearHorizontal}">
                                <Setter Property="Width" Value="292" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource MotionTextPrimaryBrush}"
                                   Text="{Binding Title}" />
                        <Border Grid.Column="1" Padding="9,3"
                                Background="{StaticResource MotionPrimaryLightBrush}"
                                CornerRadius="10">
                            <TextBlock FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource MotionBrush.Primary}"
                                       Text="{Binding RoleLabel}" />
                        </Border>
                    </Grid>
                    <ContentControl Grid.Row="1" Margin="0,14,0,0"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Content="{Binding}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="ContentTemplate"
                                        Value="{StaticResource HorizontalJogModuleTemplate}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Kind}"
                                                 Value="{x:Static multiAxis:JogModuleKind.Planar}">
                                        <Setter Property="ContentTemplate"
                                                Value="{StaticResource PlanarJogModuleTemplate}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}"
                                                 Value="{x:Static multiAxis:JogModuleKind.LinearVertical}">
                                        <Setter Property="ContentTemplate"
                                                Value="{StaticResource VerticalJogModuleTemplate}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}"
                                                 Value="{x:Static multiAxis:JogModuleKind.Rotary}">
                                        <Setter Property="ContentTemplate"
                                                Value="{StaticResource RotaryJogModuleTemplate}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Style="{StaticResource MotionPageTitleStyle}" Text="多轴运动" />
                <TextBlock Margin="0,7,0,0" FontSize="13"
                           Foreground="{StaticResource MotionTextSecondaryBrush}"
                           Text="根据分组中的轴角色自动生成方向控制" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Margin="0,0,0,16" Style="{StaticResource MotionCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,14,0" VerticalAlignment="Center"
                           Style="{StaticResource MotionFieldLabelStyle}" Text="当前分组" />
                <ComboBox x:Name="GroupSelector" Grid.Column="1"
                          Height="38" Padding="12,0"
                          Style="{StaticResource MotionComboBoxStyle}"
                          ItemsSource="{Binding Groups}"
                          SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                          DisplayMemberPath="Name"
                          IsEnabled="{Binding IsNotBusy}" />
                <Border Grid.Column="2" Margin="14,0,0,0" Padding="10,4"
                        VerticalAlignment="Center"
                        Background="{StaticResource MotionPrimaryLightBrush}" CornerRadius="12">
                    <TextBlock Foreground="{StaticResource MotionBrush.Primary}">
                        <Run FontWeight="SemiBold"
                             Text="{Binding SelectedAxisCount, Mode=OneWay}" />
                        <Run Text=" 轴" />
                    </TextBlock>
                </Border>
                <Button Grid.Column="3" Width="88" Height="36" HorizontalAlignment="Right"
                        Style="{StaticResource MotionSecondaryButton}"
                        Command="{Binding LoadCommand}" Content="重新加载" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <controls:AdaptiveMotionConsole x:Name="MotionGroupConsole"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Top"
                                                MaxWidth="1560"
                                                AxisCount="{Binding SelectedAxisCount, Mode=OneWay}">
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border"
                                   BasedOn="{StaticResource MotionCardStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasModules}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="20" FontWeight="SemiBold"
                                           Foreground="{StaticResource MotionTextPrimaryBrush}"
                                           Text="{Binding SelectedGroup.Name}" />
                                <TextBlock Margin="0,5,0,0" FontSize="12"
                                           Foreground="{StaticResource MotionTextSecondaryBrush}"
                                           Text="多轴点动控制" />
                            </StackPanel>
                            <Border Grid.Column="1" Padding="10,4"
                                    VerticalAlignment="Top"
                                    Background="{StaticResource MotionPrimaryLightBrush}"
                                    CornerRadius="12">
                                <TextBlock Foreground="{StaticResource MotionBrush.Primary}">
                                    <Run FontWeight="SemiBold"
                                         Text="{Binding SelectedAxisCount, Mode=OneWay}" />
                                    <Run Text="轴" />
                                </TextBlock>
                            </Border>
                        </Grid>

                        <Border x:Name="MotionControlSurface"
                                Grid.Row="1" Margin="0,18,0,0" Padding="12"
                                Background="{StaticResource MotionReferencePageBrush}"
                                BorderBrush="{StaticResource MotionBorderBrush}"
                                BorderThickness="1" CornerRadius="12">
                            <StackPanel>
                                <controls:MultiAxisJogLayoutPanel
                                    HorizontalAlignment="Stretch"
                                    AxisCount="{Binding SelectedAxisCount, Mode=OneWay}">
                                    <Border Margin="4" Padding="0,0,10,0"
                                            BorderBrush="{StaticResource MotionBorderBrush}"
                                            BorderThickness="0,0,1,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasLinearModules}"
                                                                 Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <ItemsControl x:Name="LinearAxisRegion"
                                                      VerticalAlignment="Center"
                                                      ItemsSource="{Binding LinearModules}"
                                                      ItemTemplate="{StaticResource JogRegionModuleTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel HorizontalAlignment="Center" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </Border>

                                    <Border Margin="4" Padding="10,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasCenterModules}"
                                                                 Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <ItemsControl x:Name="CenterAxisRegion"
                                                      VerticalAlignment="Center"
                                                      ItemsSource="{Binding CenterModules}"
                                                      ItemTemplate="{StaticResource JogRegionModuleTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel HorizontalAlignment="Center" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </Border>

                                    <Border Margin="4" Padding="10,0,0,0"
                                            BorderBrush="{StaticResource MotionBorderBrush}"
                                            BorderThickness="1,0,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasRotaryModules}"
                                                                 Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <ItemsControl x:Name="RotaryAxisRegion"
                                                      VerticalAlignment="Center"
                                                      ItemsSource="{Binding RotaryModules}"
                                                      ItemTemplate="{StaticResource JogRegionModuleTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel HorizontalAlignment="Center" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </Border>
                                </controls:MultiAxisJogLayoutPanel>

                                <Border x:Name="AuxiliaryAxisDock"
                                        Margin="4,12,4,4" Padding="12,12,12,4"
                                        Background="Transparent"
                                        BorderBrush="{StaticResource MotionBorderBrush}"
                                        BorderThickness="0,1,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasAuxiliaryModules}"
                                                             Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <ItemsControl x:Name="AuxiliaryAxisRegion"
                                                  VerticalAlignment="Center"
                                                  ItemsSource="{Binding AuxiliaryModules}"
                                                  ItemTemplate="{StaticResource JogRegionModuleTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel HorizontalAlignment="Center" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                        </Border>
                        </Grid>
                    </Border>
                </controls:AdaptiveMotionConsole>
            </ScrollViewer>

            <Border Padding="36">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource MotionEmptyStateCardStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasLoadError}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource MotionTextPrimaryBrush}"
                               Text="多轴页面加载失败" />
                    <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center"
                               Foreground="{StaticResource MotionTextSecondaryBrush}"
                               Text="{Binding StatusMessage}" TextWrapping="Wrap" />
                    <Button Margin="0,20,0,0" Width="100" HorizontalAlignment="Center"
                            Style="{StaticResource MotionPrimaryButton}"
                            Command="{Binding LoadCommand}" Content="重试" />
                </StackPanel>
            </Border>

            <Border Padding="36">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource MotionEmptyStateCardStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsBusy}" Value="False" />
                                            <Condition Binding="{Binding HasLoadError}" Value="False" />
                                            <Condition Binding="{Binding HasGroups}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource MotionTextPrimaryBrush}"
                               Text="尚未创建分组" />
                    <TextBlock Margin="0,9,0,0" HorizontalAlignment="Center"
                               Foreground="{StaticResource MotionTextSecondaryBrush}"
                               Text="请先到“分组管理”创建分组并分配轴。" />
                </StackPanel>
            </Border>

            <Border Padding="36">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource MotionEmptyStateCardStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsBusy}" Value="False" />
                                            <Condition Binding="{Binding HasLoadError}" Value="False" />
                                            <Condition Binding="{Binding HasGroups}" Value="True" />
                                            <Condition Binding="{Binding HasModules}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource MotionTextPrimaryBrush}"
                               Text="当前分组没有轴" />
                    <TextBlock Margin="0,9,0,0" HorizontalAlignment="Center"
                               Foreground="{StaticResource MotionTextSecondaryBrush}"
                               Text="请在“分组管理”中为该分组添加轴并设置角色。" />
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>
