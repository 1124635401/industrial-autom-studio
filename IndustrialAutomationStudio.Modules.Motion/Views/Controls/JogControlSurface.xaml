<UserControl x:Class="IndustrialAutomationStudio.Modules.Motion.Views.Controls.JogControlSurface"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:IndustrialAutomationStudio.Modules.Motion.Views.Controls"
             xmlns:multiAxis="clr-namespace:IndustrialAutomationStudio.Modules.Motion.ViewModels.MultiAxis">
    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/IndustrialAutomationStudio.Modules.Motion;component/Resources/MotionTheme.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <Style x:Key="JogDirectionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="68" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource MotionTextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource MotionBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{StaticResource MotionPrimaryLightBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#FF91BAF4" />
                                <Setter Property="Foreground" Value="{StaticResource MotionBrush.Primary}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{StaticResource MotionBrush.Primary}" />
                                <Setter TargetName="Chrome" Property="BorderBrush"
                                        Value="{StaticResource MotionBrush.Primary}" />
                                <Setter Property="Foreground" Value="White" />
                            </DataTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AdaptiveJogDirectionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource JogDirectionButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Density, ElementName=Root}"
                             Value="{x:Static local:JogSurfaceDensity.Compact}">
                    <Setter Property="Width" Value="72" />
                    <Setter Property="Height" Value="54" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="Margin" Value="4" />
                    <Setter Property="Padding" Value="6,3" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PlanarVerticalButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource AdaptiveJogDirectionButtonStyle}">
            <Setter Property="Margin" Value="8,2" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Density, ElementName=Root}"
                             Value="{x:Static local:JogSurfaceDensity.Compact}">
                    <Setter Property="Margin" Value="4" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PlanarHorizontalButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource AdaptiveJogDirectionButtonStyle}">
            <Setter Property="Margin" Value="2,8" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Density, ElementName=Root}"
                             Value="{x:Static local:JogSurfaceDensity.Compact}">
                    <Setter Property="Margin" Value="4" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="JogDirectionSymbolStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
            <Setter Property="FontSize" Value="23" />
            <Setter Property="Foreground"
                    Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Density, ElementName=Root}"
                             Value="{x:Static local:JogSurfaceDensity.Compact}">
                    <Setter Property="FontSize" Value="18" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="JogDirectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground"
                    Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Density, ElementName=Root}"
                             Value="{x:Static local:JogSurfaceDensity.Compact}">
                    <Setter Property="FontSize" Value="13" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="HorizontalDirectionButtonTemplate">
            <Button Style="{StaticResource AdaptiveJogDirectionButtonStyle}"
                    IsEnabled="{Binding IsInteractionEnabled, ElementName=Root}"
                    PreviewMouseLeftButtonDown="DirectionButton_OnPreviewMouseLeftButtonDown"
                    PreviewMouseLeftButtonUp="DirectionButton_OnPreviewMouseLeftButtonUp"
                    LostMouseCapture="DirectionButton_OnLostMouseCapture">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="0,0,8,0" VerticalAlignment="Center"
                               Style="{StaticResource JogDirectionSymbolStyle}"
                               Text="{Binding Symbol}" />
                    <TextBlock VerticalAlignment="Center"
                               Style="{StaticResource JogDirectionLabelStyle}"
                               Text="{Binding Label}" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="PlanarJogModuleTemplate">
            <Grid x:Name="PlanarGrid"
                  HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Width" Value="326" />
                        <Setter Property="Height" Value="280" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Density, ElementName=Root}"
                                         Value="{x:Static local:JogSurfaceDensity.Compact}">
                                <Setter Property="Width" Value="240" />
                                <Setter Property="Height" Value="186" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Row="0" Grid.Column="1"
                        Style="{StaticResource PlanarVerticalButtonStyle}"
                        DataContext="{Binding Directions[0]}"
                        IsEnabled="{Binding IsInteractionEnabled, ElementName=Root}"
                        PreviewMouseLeftButtonDown="DirectionButton_OnPreviewMouseLeftButtonDown"
                        PreviewMouseLeftButtonUp="DirectionButton_OnPreviewMouseLeftButtonUp"
                        LostMouseCapture="DirectionButton_OnLostMouseCapture">
                    <StackPanel>
                        <TextBlock HorizontalAlignment="Center"
                                   Style="{StaticResource JogDirectionSymbolStyle}"
                                   Text="{Binding Symbol}" />
                        <TextBlock Margin="0,2,0,0" HorizontalAlignment="Center"
                                   Style="{StaticResource JogDirectionLabelStyle}"
                                   Text="{Binding Label}" />
                    </StackPanel>
                </Button>

                <Button Grid.Row="1" Grid.Column="0"
                        Style="{StaticResource PlanarHorizontalButtonStyle}"
                        DataContext="{Binding Directions[1]}"
                        IsEnabled="{Binding IsInteractionEnabled, ElementName=Root}"
                        PreviewMouseLeftButtonDown="DirectionButton_OnPreviewMouseLeftButtonDown"
                        PreviewMouseLeftButtonUp="DirectionButton_OnPreviewMouseLeftButtonUp"
                        LostMouseCapture="DirectionButton_OnLostMouseCapture">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,8,0" VerticalAlignment="Center"
                                   Style="{StaticResource JogDirectionSymbolStyle}"
                                   Text="{Binding Symbol}" />
                        <TextBlock VerticalAlignment="Center"
                                   Style="{StaticResource JogDirectionLabelStyle}"
                                   Text="{Binding Label}" />
                    </StackPanel>
                </Button>

                <Grid Grid.Row="1" Grid.Column="1" Width="54" Height="54"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Density, ElementName=Root}"
                                             Value="{x:Static local:JogSurfaceDensity.Compact}">
                                    <Setter Property="Width" Value="32" />
                                    <Setter Property="Height" Value="32" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Ellipse Stroke="{StaticResource MotionTextSecondaryBrush}" StrokeThickness="1.4" />
                    <Viewbox Stretch="Fill">
                        <Canvas Width="54" Height="54">
                            <Ellipse Canvas.Left="20.5" Canvas.Top="20.5" Width="13" Height="13"
                                     Fill="{StaticResource MotionPrimaryLightBrush}"
                                     Stroke="{StaticResource MotionTextSecondaryBrush}" StrokeThickness="1" />
                            <Path Stretch="Fill" Stroke="{StaticResource MotionTextSecondaryBrush}" StrokeThickness="1.2"
                                  Data="M27,0 L27,14 M27,40 L27,54 M0,27 L14,27 M40,27 L54,27" />
                        </Canvas>
                    </Viewbox>
                </Grid>

                <Button Grid.Row="1" Grid.Column="2"
                        Style="{StaticResource PlanarHorizontalButtonStyle}"
                        DataContext="{Binding Directions[2]}"
                        IsEnabled="{Binding IsInteractionEnabled, ElementName=Root}"
                        PreviewMouseLeftButtonDown="DirectionButton_OnPreviewMouseLeftButtonDown"
                        PreviewMouseLeftButtonUp="DirectionButton_OnPreviewMouseLeftButtonUp"
                        LostMouseCapture="DirectionButton_OnLostMouseCapture">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,8,0" VerticalAlignment="Center"
                                   Style="{StaticResource JogDirectionSymbolStyle}"
                                   Text="{Binding Symbol}" />
                        <TextBlock VerticalAlignment="Center"
                                   Style="{StaticResource JogDirectionLabelStyle}"
                                   Text="{Binding Label}" />
                    </StackPanel>
                </Button>

                <Button Grid.Row="2" Grid.Column="1"
                        Style="{StaticResource PlanarVerticalButtonStyle}"
                        DataContext="{Binding Directions[3]}"
                        IsEnabled="{Binding IsInteractionEnabled, ElementName=Root}"
                        PreviewMouseLeftButtonDown="DirectionButton_OnPreviewMouseLeftButtonDown"
                        PreviewMouseLeftButtonUp="DirectionButton_OnPreviewMouseLeftButtonUp"
                        LostMouseCapture="DirectionButton_OnLostMouseCapture">
                    <StackPanel>
                        <TextBlock HorizontalAlignment="Center"
                                   Style="{StaticResource JogDirectionSymbolStyle}"
                                   Text="{Binding Symbol}" />
                        <TextBlock Margin="0,2,0,0" HorizontalAlignment="Center"
                                   Style="{StaticResource JogDirectionLabelStyle}"
                                   Text="{Binding Label}" />
                    </StackPanel>
                </Button>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="VerticalJogModuleTemplate">
            <ItemsControl ItemsSource="{Binding Directions}"
                          ItemTemplate="{StaticResource HorizontalDirectionButtonTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Margin" Value="0,6" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Density, ElementName=Root}"
                                         Value="{x:Static local:JogSurfaceDensity.Compact}">
                                <Setter Property="Margin" Value="0,3" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.ItemContainerStyle>
            </ItemsControl>
        </DataTemplate>

        <DataTemplate x:Key="HorizontalJogModuleTemplate">
            <ItemsControl ItemsSource="{Binding Directions}"
                          ItemTemplate="{StaticResource HorizontalDirectionButtonTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Margin" Value="6,0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Density, ElementName=Root}"
                                         Value="{x:Static local:JogSurfaceDensity.Compact}">
                                <Setter Property="Margin" Value="3,0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.ItemContainerStyle>
            </ItemsControl>
        </DataTemplate>

        <DataTemplate x:Key="JogRegionModuleTemplate">
            <Border Background="Transparent">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Width" Value="172" />
                        <Setter Property="Margin" Value="8" />
                        <Setter Property="Padding" Value="14" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Kind}"
                                         Value="{x:Static multiAxis:JogModuleKind.Planar}">
                                <Setter Property="Width" Value="374" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}"
                                         Value="{x:Static multiAxis:JogModuleKind.LinearHorizontal}">
                                <Setter Property="Width" Value="292" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Density, ElementName=Root}"
                                               Value="{x:Static local:JogSurfaceDensity.Compact}" />
                                    <Condition Binding="{Binding Kind}"
                                               Value="{x:Static multiAxis:JogModuleKind.Planar}" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Width" Value="256" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Density, ElementName=Root}"
                                               Value="{x:Static local:JogSurfaceDensity.Compact}" />
                                    <Condition Binding="{Binding Kind}"
                                               Value="{x:Static multiAxis:JogModuleKind.LinearHorizontal}" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Width" Value="176" />
                            </MultiDataTrigger>
                            <DataTrigger Binding="{Binding Density, ElementName=Root}"
                                         Value="{x:Static local:JogSurfaceDensity.Compact}">
                                <Setter Property="Margin" Value="3" />
                                <Setter Property="Padding" Value="5" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource MotionTextPrimaryBrush}"
                                   Text="{Binding Title}" />
                        <Border Grid.Column="1" Padding="9,3"
                                Background="{StaticResource MotionPrimaryLightBrush}"
                                CornerRadius="10">
                            <TextBlock FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource MotionBrush.Primary}"
                                       Text="{Binding RoleLabel}" />
                        </Border>
                    </Grid>
                    <ContentControl Grid.Row="1" Margin="0,14,0,0"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Content="{Binding}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="ContentTemplate"
                                        Value="{StaticResource HorizontalJogModuleTemplate}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Kind}"
                                                 Value="{x:Static multiAxis:JogModuleKind.Planar}">
                                        <Setter Property="ContentTemplate"
                                                Value="{StaticResource PlanarJogModuleTemplate}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}"
                                                 Value="{x:Static multiAxis:JogModuleKind.LinearVertical}">
                                        <Setter Property="ContentTemplate"
                                                Value="{StaticResource VerticalJogModuleTemplate}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}"
                                                 Value="{x:Static multiAxis:JogModuleKind.Rotary}">
                                        <Setter Property="ContentTemplate"
                                                Value="{StaticResource VerticalJogModuleTemplate}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Density, ElementName=Root}"
                                                 Value="{x:Static local:JogSurfaceDensity.Compact}">
                                        <Setter Property="Margin" Value="0,5,0,0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </Grid>
            </Border>
        </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <local:MultiAxisJogLayoutPanel AxisCount="{Binding AxisCount, ElementName=Root}">
            <ItemsControl x:Name="LinearRegion"
                          ItemsSource="{Binding LinearModules, ElementName=Root}"
                          ItemTemplate="{StaticResource JogRegionModuleTemplate}">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasItems, RelativeSource={RelativeSource Self}}"
                                         Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <ItemsControl x:Name="CenterRegion"
                          ItemsSource="{Binding CenterModules, ElementName=Root}"
                          ItemTemplate="{StaticResource JogRegionModuleTemplate}">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasItems, RelativeSource={RelativeSource Self}}"
                                         Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <ItemsControl x:Name="RotaryRegion"
                          ItemsSource="{Binding RotaryModules, ElementName=Root}"
                          ItemTemplate="{StaticResource JogRegionModuleTemplate}">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasItems, RelativeSource={RelativeSource Self}}"
                                         Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </local:MultiAxisJogLayoutPanel>

        <ItemsControl x:Name="AuxiliaryRegion"
                      Margin="4,12,4,4"
                      ItemsSource="{Binding AuxiliaryModules, ElementName=Root}"
                      ItemTemplate="{StaticResource JogRegionModuleTemplate}">
            <ItemsControl.Style>
                <Style TargetType="ItemsControl">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasItems, RelativeSource={RelativeSource Self}}"
                                     Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ItemsControl.Style>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel HorizontalAlignment="Center" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </StackPanel>
</UserControl>
