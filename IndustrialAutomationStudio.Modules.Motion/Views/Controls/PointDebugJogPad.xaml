<UserControl x:Class="IndustrialAutomationStudio.Modules.Motion.Views.Controls.PointDebugJogPad"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="300" Height="218">
    <UserControl.Resources>
        <Style x:Key="PointDebugDirectionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#FFFAFCFF" />
            <Setter Property="Foreground" Value="#FF26364D" />
            <Setter Property="BorderBrush" Value="{StaticResource MotionBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{StaticResource MotionPrimaryLightBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush"
                                        Value="{StaticResource MotionBrush.Primary}" />
                                <Setter Property="Foreground" Value="{StaticResource MotionBrush.Primary}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{StaticResource MotionBrush.Primary}" />
                                <Setter TargetName="Chrome" Property="BorderBrush"
                                        Value="{StaticResource MotionBrush.Primary}" />
                                <Setter Property="Foreground" Value="White" />
                            </DataTrigger>
                            <Trigger Property="DataContext" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PointDebugStopButtonStyle" TargetType="Button"
               BasedOn="{StaticResource PointDebugDirectionButtonStyle}">
            <Setter Property="Background" Value="#FFFFF1F0" />
            <Setter Property="Foreground" Value="#FFCF1322" />
            <Setter Property="BorderBrush" Value="#FFFFCCC7" />
        </Style>

        <DataTemplate x:Key="PointDebugDirectionTemplate">
            <Button Style="{StaticResource PointDebugDirectionButtonStyle}"
                    IsEnabled="{Binding IsInteractionEnabled,
                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                    PreviewMouseLeftButtonDown="DirectionButton_OnPreviewMouseLeftButtonDown"
                    PreviewMouseLeftButtonUp="DirectionButton_OnPreviewMouseLeftButtonUp"
                    LostMouseCapture="DirectionButton_OnLostMouseCapture">
                <StackPanel>
                    <TextBlock HorizontalAlignment="Center" FontFamily="Segoe UI Symbol"
                               FontSize="20" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                               Text="{Binding Symbol}" />
                    <TextBlock Margin="0,1,0,0" HorizontalAlignment="Center" FontSize="9"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                               Text="{Binding Label}" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Border Padding="10" Background="White"
            BorderBrush="{StaticResource MotionBorderBrush}"
            BorderThickness="1" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="2"
                              Opacity="0.05" Color="#FF000000" />
        </Border.Effect>
        <Grid>
            <Grid Width="156" Height="156"
                  HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ContentControl Grid.Row="0" Grid.Column="0" Content="{Binding JogPad.ZPositive, ElementName=Root}"
                                ContentTemplate="{StaticResource PointDebugDirectionTemplate}" />
                <ContentControl Grid.Row="0" Grid.Column="1" Content="{Binding JogPad.YPositive, ElementName=Root}"
                                ContentTemplate="{StaticResource PointDebugDirectionTemplate}" />
                <ContentControl Grid.Row="0" Grid.Column="2" Content="{Binding JogPad.RPositive, ElementName=Root}"
                                ContentTemplate="{StaticResource PointDebugDirectionTemplate}" />
                <ContentControl Grid.Row="1" Grid.Column="0" Content="{Binding JogPad.XNegative, ElementName=Root}"
                                ContentTemplate="{StaticResource PointDebugDirectionTemplate}" />
                <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource PointDebugStopButtonStyle}"
                        Command="{Binding StopAllCommand, ElementName=Root}" ToolTip="停止当前分组">
                    <TextBlock FontSize="20" FontWeight="Bold" Text="■" />
                </Button>
                <ContentControl Grid.Row="1" Grid.Column="2" Content="{Binding JogPad.XPositive, ElementName=Root}"
                                ContentTemplate="{StaticResource PointDebugDirectionTemplate}" />
                <ContentControl Grid.Row="2" Grid.Column="0" Content="{Binding JogPad.ZNegative, ElementName=Root}"
                                ContentTemplate="{StaticResource PointDebugDirectionTemplate}" />
                <ContentControl Grid.Row="2" Grid.Column="1" Content="{Binding JogPad.YNegative, ElementName=Root}"
                                ContentTemplate="{StaticResource PointDebugDirectionTemplate}" />
                <ContentControl Grid.Row="2" Grid.Column="2" Content="{Binding JogPad.RNegative, ElementName=Root}"
                                ContentTemplate="{StaticResource PointDebugDirectionTemplate}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
