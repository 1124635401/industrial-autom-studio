<UserControl x:Class="IndustrialAutomationStudio.Modules.Motion.Views.Controls.AxisControlCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pointDebug="clr-namespace:IndustrialAutomationStudio.Modules.Motion.ViewModels.PointDebug"
             Width="300" Height="218">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="AxisCardStatusDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="6" />
            <Setter Property="Height" Value="6" />
            <Setter Property="Fill" Value="#FFAEB7C5" />
        </Style>

        <Style x:Key="AxisCardModeButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource MotionTextSecondaryBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="White" />
                                <Setter Property="Foreground" Value="{StaticResource MotionBrush.Primary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AxisCardSelectedModeButtonStyle" TargetType="Button"
               BasedOn="{StaticResource AxisCardModeButtonStyle}">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource MotionBrush.Primary}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="AxisCardParameterTextBoxStyle" TargetType="TextBox"
               BasedOn="{StaticResource MotionReferenceInputStyle}">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="AxisCardToolButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="20" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource MotionTextSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource MotionBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.62" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AxisCardServoToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Width="28" Height="16">
                            <Border x:Name="Track" Background="#FFD5DAE2" CornerRadius="8" />
                            <Ellipse x:Name="Thumb" Width="12" Height="12" Margin="2"
                                     HorizontalAlignment="Left" Fill="White" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background"
                                        Value="{StaticResource MotionBrush.Success}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Padding="10" Background="White"
            BorderBrush="{StaticResource MotionBorderBrush}"
            BorderThickness="1" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="2"
                              Opacity="0.05" Color="#FF000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="24" />
                <RowDefinition Height="30" />
                <RowDefinition Height="46" />
                <RowDefinition Height="38" />
                <RowDefinition Height="54" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="22" Height="22" Background="{StaticResource MotionBrush.Primary}"
                        CornerRadius="4">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="12" FontWeight="Bold" Foreground="White"
                               Text="{Binding Role}" />
                </Border>
                <TextBlock Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center"
                           FontSize="13" FontWeight="SemiBold"
                           Text="{Binding AxisLabel}" />
                <TextBlock Grid.Column="2" Margin="0,0,9,0" VerticalAlignment="Center"
                           FontSize="9" Foreground="{StaticResource MotionTextSecondaryBrush}"
                           Text="{Binding AxisNumberText}" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Margin="0,0,4,0" VerticalAlignment="Center" FontSize="9" Text="使能" />
                    <ToggleButton Style="{StaticResource AxisCardServoToggleStyle}"
                                  IsChecked="{Binding ServoOn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Command="{Binding ToggleServoCommand}"
                                  CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}"
                                  ToolTip="切换轴伺服使能" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Margin="0,3,0,2" Padding="6,0"
                    Background="{StaticResource MotionReferencePageBrush}"
                    BorderBrush="{StaticResource MotionBorderBrush}"
                    BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource AxisCardToolButtonStyle}"
                            IsEnabled="False" Content="●  报警清除"
                            ToolTipService.ShowOnDisabled="True"
                            ToolTip="当前驱动尚未提供轴级报警清除 API" />
                    <Button Grid.Column="1" Margin="5,0,0,0"
                            Style="{StaticResource AxisCardToolButtonStyle}"
                            IsEnabled="False" Content="↺  复位"
                            ToolTipService.ShowOnDisabled="True"
                            ToolTip="当前驱动尚未提供轴级复位 API" />
                    <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                               FontSize="8" Foreground="{StaticResource MotionTextSecondaryBrush}"
                               Text="{Binding StateText}" />
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="92" />
                </Grid.ColumnDefinitions>
                <Border Padding="6,3" BorderBrush="{StaticResource MotionBorderBrush}"
                        BorderThickness="1" CornerRadius="8">
                    <UniformGrid Columns="3" Rows="2">
                        <StackPanel Orientation="Horizontal"><Ellipse><Ellipse.Style><Style TargetType="Ellipse" BasedOn="{StaticResource AxisCardStatusDotStyle}"><Style.Triggers><DataTrigger Binding="{Binding NegativeLimit}" Value="True"><Setter Property="Fill" Value="{StaticResource MotionBrush.Danger}" /></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><TextBlock Margin="3,0,0,0" FontSize="8" Text="负限" /></StackPanel>
                        <StackPanel Orientation="Horizontal"><Ellipse><Ellipse.Style><Style TargetType="Ellipse" BasedOn="{StaticResource AxisCardStatusDotStyle}"><Style.Triggers><DataTrigger Binding="{Binding HomeSensor}" Value="True"><Setter Property="Fill" Value="{StaticResource MotionBrush.Primary}" /></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><TextBlock Margin="3,0,0,0" FontSize="8" Text="原点" /></StackPanel>
                        <StackPanel Orientation="Horizontal"><Ellipse><Ellipse.Style><Style TargetType="Ellipse" BasedOn="{StaticResource AxisCardStatusDotStyle}"><Style.Triggers><DataTrigger Binding="{Binding PositiveLimit}" Value="True"><Setter Property="Fill" Value="{StaticResource MotionBrush.Danger}" /></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><TextBlock Margin="3,0,0,0" FontSize="8" Text="正限" /></StackPanel>
                        <StackPanel Orientation="Horizontal"><Ellipse><Ellipse.Style><Style TargetType="Ellipse" BasedOn="{StaticResource AxisCardStatusDotStyle}"><Style.Triggers><DataTrigger Binding="{Binding Alarm}" Value="True"><Setter Property="Fill" Value="{StaticResource MotionBrush.Danger}" /></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><TextBlock Margin="3,0,0,0" FontSize="8" Text="报警" /></StackPanel>
                        <StackPanel Orientation="Horizontal"><Ellipse><Ellipse.Style><Style TargetType="Ellipse" BasedOn="{StaticResource AxisCardStatusDotStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsMoving}" Value="True"><Setter Property="Fill" Value="{StaticResource MotionBrush.Success}" /></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><TextBlock Margin="3,0,0,0" FontSize="8" Text="运动" /></StackPanel>
                        <StackPanel Orientation="Horizontal"><Ellipse><Ellipse.Style><Style TargetType="Ellipse" BasedOn="{StaticResource AxisCardStatusDotStyle}"><Style.Triggers><DataTrigger Binding="{Binding InPosition}" Value="True"><Setter Property="Fill" Value="{StaticResource MotionBrush.Success}" /></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><TextBlock Margin="3,0,0,0" FontSize="8" Text="到位" /></StackPanel>
                    </UniformGrid>
                </Border>
                <Border Grid.Column="1" Margin="5,0,0,0" Background="{StaticResource MotionReferencePageBrush}"
                        BorderBrush="{StaticResource MotionBorderBrush}" BorderThickness="1"
                        CornerRadius="14">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock FontFamily="Consolas" FontSize="15" FontWeight="SemiBold"
                                   Text="{Binding Position, StringFormat={}{0:F3}}" />
                        <TextBlock Margin="4,0,0,0" VerticalAlignment="Bottom" FontSize="9"
                                   Foreground="{StaticResource MotionTextSecondaryBrush}" Text="{Binding Unit}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="3" Margin="0,2" Padding="3"
                    Background="#FFF1F4F9" BorderBrush="{StaticResource MotionBorderBrush}"
                    BorderThickness="1" CornerRadius="14">
                <UniformGrid Columns="3">
                    <Button Command="{Binding SelectModeCommand}"
                            CommandParameter="{x:Static pointDebug:AxisMotionMode.Continuous}"
                            Content="连续运动">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource AxisCardModeButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsContinuousMode}" Value="True"><Setter Property="Background" Value="White" /><Setter Property="Foreground" Value="{StaticResource MotionBrush.Primary}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers></Style></Button.Style>
                    </Button>
                    <Button Command="{Binding SelectModeCommand}"
                            CommandParameter="{x:Static pointDebug:AxisMotionMode.Relative}"
                            Content="相对运动">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource AxisCardModeButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsRelativeMode}" Value="True"><Setter Property="Background" Value="White" /><Setter Property="Foreground" Value="{StaticResource MotionBrush.Primary}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers></Style></Button.Style>
                    </Button>
                    <Button Command="{Binding SelectModeCommand}"
                            CommandParameter="{x:Static pointDebug:AxisMotionMode.Absolute}"
                            Content="绝对运动">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource AxisCardModeButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsAbsoluteMode}" Value="True"><Setter Property="Background" Value="White" /><Setter Property="Foreground" Value="{StaticResource MotionBrush.Primary}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers></Style></Button.Style>
                    </Button>
                </UniformGrid>
            </Border>

            <Grid Grid.Row="4">
                <Grid Visibility="{Binding IsContinuousMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontSize="9" Foreground="{StaticResource MotionTextSecondaryBrush}" Text="Jog 速度" />
                    <TextBox Grid.Column="1" Margin="7,3" Style="{StaticResource AxisCardParameterTextBoxStyle}" Text="{Binding JogSpeed, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="9" Foreground="{StaticResource MotionTextSecondaryBrush}" Text="{Binding SpeedUnit}" />
                </Grid>
                <Grid Visibility="{Binding IsRelativeMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="70" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="70" /></Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontSize="8" Foreground="{StaticResource MotionTextSecondaryBrush}" Text="相对距离" />
                    <TextBox Grid.Column="1" Margin="5,3" Style="{StaticResource AxisCardParameterTextBoxStyle}" Text="{Binding RelativeDistance, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="8" Foreground="{StaticResource MotionTextSecondaryBrush}" Text="运动速度" />
                    <TextBox Grid.Column="3" Margin="5,3,0,3" Style="{StaticResource AxisCardParameterTextBoxStyle}" Text="{Binding MotionSpeed, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <Grid Visibility="{Binding IsAbsoluteMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="70" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="70" /></Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontSize="8" Foreground="{StaticResource MotionTextSecondaryBrush}" Text="目标位置" />
                    <TextBox Grid.Column="1" Margin="5,3" Style="{StaticResource AxisCardParameterTextBoxStyle}" Text="{Binding TargetPosition, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="8" Foreground="{StaticResource MotionTextSecondaryBrush}" Text="运动速度" />
                    <TextBox Grid.Column="3" Margin="5,3,0,3" Style="{StaticResource AxisCardParameterTextBoxStyle}" Text="{Binding MotionSpeed, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
