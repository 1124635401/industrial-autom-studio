<UserControl x:Class="IndustrialAutomationStudio.Modules.Motion.Views.PointDebugView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:controls="clr-namespace:IndustrialAutomationStudio.Modules.Motion.Views.Controls"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="Transparent"
             Loaded="PointDebugView_OnLoaded"
             Unloaded="PointDebugView_OnUnloaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="PointDebugAxisCardHostStyle" TargetType="controls:AxisControlCard">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <Trigger Property="DataContext" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PointDebugToolbarButtonStyle" TargetType="Button"
               BasedOn="{StaticResource MotionSecondaryButton}">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="46" />
            <Setter Property="Margin" Value="5,0,0,0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="PointDebugInnerCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource MotionBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Effect" Value="{x:Null}" />
        </Style>

        <Style x:Key="PointDebugPointItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,9" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource MotionBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chrome" Padding="11"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FFF8FAFD" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FFFAFDFF" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#FF91CAFF" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{StaticResource MotionPrimaryLightBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="PointDebugAxisValueTemplate">
            <Border Height="31" Margin="0,0,6,6" Padding="8,0"
                    Background="{StaticResource MotionReferencePageBrush}"
                    BorderBrush="#FFE9EDF2" BorderThickness="1" CornerRadius="7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource MotionBrush.Primary}" Text="{Binding AxisLabel}" />
                    <Grid Grid.Column="1">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsEditing,
                                            RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                     Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock FontFamily="Consolas" FontSize="11"
                                       Text="{Binding Position, StringFormat={}{0:F3}}" />
                            <TextBlock Margin="3,0,0,0" FontSize="8"
                                       Foreground="{StaticResource MotionTextSecondaryBrush}"
                                       Text="{Binding Unit}" />
                        </StackPanel>
                        <TextBox Height="25" HorizontalContentAlignment="Right"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding PositionText, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource MotionReferenceInputStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsEditing,
                                            RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                     Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="PointDebugRoot">
        <Border x:Name="PointDebugPageContainer"
                Background="White"
                BorderBrush="{StaticResource MotionBorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="56" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border x:Name="CurrentGroupToolbar"
                        Padding="24,0"
                        Background="White"
                        BorderBrush="#FFF0F0F0"
                        BorderThickness="0,0,0,1"
                        CornerRadius="13,13,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Margin="0,0,10,0" VerticalAlignment="Center"
                                   FontSize="14" FontWeight="SemiBold" Text="当前分组" />
                        <ComboBox Width="230" Height="36" Padding="12,0"
                                  Style="{StaticResource MotionComboBoxStyle}"
                                  ItemsSource="{Binding Groups}"
                                  SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                                  DisplayMemberPath="Name"
                                  IsEnabled="{Binding IsInteractionEnabled}" />
                        <Border Margin="8,0,0,0" Padding="10,4" VerticalAlignment="Center"
                                Background="{StaticResource MotionPrimaryLightBrush}" CornerRadius="12">
                            <TextBlock Foreground="{StaticResource MotionBrush.Primary}">
                                <Run FontWeight="SemiBold"
                                     Text="{Binding SelectedAxisCount, Mode=OneWay}" />
                                <Run Text=" 轴" />
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Border>

                <Border x:Name="PointDebugContentSurface"
                        Grid.Row="1"
                        Padding="20"
                        Background="Transparent"
                        CornerRadius="0,0,13,13">
                    <Grid x:Name="PointDebugWorkspace">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="720" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="414" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PointDebugInnerCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Padding="18,0" BorderBrush="#FFF0F0F0"
                            BorderThickness="0,0,0,1" CornerRadius="11,11,0,0">
                        <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource MotionTextPrimaryBrush}" Text="运动控制" />
                    </Border>

                    <Border Grid.Row="1" Background="#FFFBFCFE" CornerRadius="0,0,11,11">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                            <Grid Margin="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <controls:AxisControlCard Grid.Row="0" Grid.Column="1" Margin="0,0,0,24"
                                                          Style="{StaticResource PointDebugAxisCardHostStyle}"
                                                          DataContext="{Binding YAxisCard}" />
                                <controls:AxisControlCard Grid.Row="1" Grid.Column="0" Margin="0,0,24,0"
                                                          Style="{StaticResource PointDebugAxisCardHostStyle}"
                                                          DataContext="{Binding XAxisCard}" />
                <controls:PointDebugJogPad Grid.Row="1" Grid.Column="1"
                                           JogPad="{Binding JogPad}"
                                           IsInteractionEnabled="{Binding IsInteractionEnabled}"
                                           StartCommand="{Binding StartJogCommand}"
                                           StopCommand="{Binding StopJogCommand}"
                                           StopAllCommand="{Binding StopGroupCommand}" />
                                <controls:AxisControlCard Grid.Row="1" Grid.Column="2" Margin="24,0,0,0"
                                                          Style="{StaticResource PointDebugAxisCardHostStyle}"
                                                          DataContext="{Binding ZAxisCard}" />
                                <controls:AxisControlCard Grid.Row="2" Grid.Column="1" Margin="0,24,0,0"
                                                          Style="{StaticResource PointDebugAxisCardHostStyle}"
                                                          DataContext="{Binding RAxisCard}" />
                            </Grid>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource PointDebugInnerCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="44" />
                    </Grid.RowDefinitions>

                    <Border Padding="18,0" BorderBrush="#FFF0F0F0"
                            BorderThickness="0,0,0,1" CornerRadius="11,11,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource MotionTextPrimaryBrush}" Text="点位列表" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource MotionPrimaryButton}"
                                        Height="28" MinWidth="54" Margin="0" Padding="10,0"
                                        FontSize="11" Command="{Binding RecordCurrentPositionCommand}"
                                        Content="＋ 新增" />
                                <Button Style="{StaticResource PointDebugToolbarButtonStyle}"
                                        Command="{Binding BeginEditPointCommand}"
                                        CommandParameter="{Binding SelectedPoint}" Content="编辑" />
                                <Button Style="{StaticResource PointDebugToolbarButtonStyle}"
                                        Command="{Binding SavePointCommand}"
                                        CommandParameter="{Binding SelectedPoint}" Content="保存" />
                                <Button Style="{StaticResource PointDebugToolbarButtonStyle}"
                                        Foreground="{StaticResource MotionDangerBrush}"
                                        BorderBrush="#FFF0B8B8"
                                        Command="{Binding DeletePointCommand}"
                                        CommandParameter="{Binding SelectedPoint}" Content="删除" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="1" Margin="10" Padding="0"
                             Background="#FFFBFCFE" BorderThickness="0"
                             ItemsSource="{Binding Points}"
                             SelectedItem="{Binding SelectedPoint, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource PointDebugPointItemStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="32" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="32" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="82" />
                                        </Grid.ColumnDefinitions>
                                        <Grid>
                                            <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                                                       Text="{Binding Name}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers><DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBox Height="28" VerticalContentAlignment="Center"
                                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox" BasedOn="{StaticResource MotionReferenceInputStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers><DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                        </Grid>
                                        <Border Grid.Column="1" Margin="6,0" Padding="7,3"
                                                Background="{StaticResource MotionReferencePageBrush}" CornerRadius="10">
                                            <TextBlock FontSize="9" Foreground="{StaticResource MotionTextSecondaryBrush}"
                                                       Text="{Binding StatusText}" />
                                        </Border>
                                        <Grid Grid.Column="2">
                                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       FontSize="9" Foreground="{StaticResource MotionTextSecondaryBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style>
                                                </TextBlock.Style>
                                                <Run Text="速度 " /><Run Text="{Binding Speed, StringFormat={}{0:G}}" />
                                            </TextBlock>
                                            <TextBox Height="28" HorizontalContentAlignment="Right"
                                                     VerticalContentAlignment="Center"
                                                     Text="{Binding SpeedText, UpdateSourceTrigger=PropertyChanged}">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox" BasedOn="{StaticResource MotionReferenceInputStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers><DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                        </Grid>
                                    </Grid>

                                    <ItemsControl Grid.Row="1" Margin="0,7,0,1"
                                                  ItemsSource="{Binding AxisCells}"
                                                  ItemTemplate="{StaticResource PointDebugAxisValueTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>

                                    <Grid Grid.Row="2">
                                        <Button Width="60" Height="28" HorizontalAlignment="Left"
                                                Style="{StaticResource MotionPrimaryButton}"
                                                Command="{Binding DataContext.LocatePointCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Content="定位" />
                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   FontSize="8" Foreground="{StaticResource MotionTextSecondaryBrush}"
                                                   Text="当前分组点位" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="2" Padding="13,0" Background="{StaticResource MotionReferencePageBrush}"
                            BorderBrush="#FFF0F0F0" BorderThickness="0,1,0,0"
                            CornerRadius="0,0,11,11">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Margin="0,0,7,0"
                                     Style="{StaticResource MotionStatusDotStyle}" />
                            <TextBlock VerticalAlignment="Center" FontSize="10"
                                       Foreground="{StaticResource MotionTextSecondaryBrush}"
                                       Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
