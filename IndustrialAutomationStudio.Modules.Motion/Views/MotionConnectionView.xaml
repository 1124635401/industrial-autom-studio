<UserControl x:Class="IndustrialAutomationStudio.Modules.Motion.Views.MotionConnectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="Transparent"
             SizeChanged="MotionConnectionView_OnSizeChanged">
    <UserControl.Resources>
        <Style x:Key="ConnectionFieldLabelStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource MotionFieldLabelStyle}">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="ConnectionHintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MotionTextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="ConnectionValidationStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,5,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MotionDangerBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ConnectionFileTextBoxStyle"
               TargetType="TextBox"
               BasedOn="{StaticResource MotionInputStyle}">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
        </Style>

        <Style x:Key="ConnectionFileButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Foreground" Value="{StaticResource MotionTextPrimaryBrush}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource MotionBorderBrush}" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{StaticResource MotionPrimaryLightBrush}" />
                                <Setter Property="Foreground"
                                        Value="{StaticResource MotionBrush.Primary}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{StaticResource MotionPrimaryHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{StaticResource MotionDisabledBrush}" />
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ConnectionAdvancedExpanderStyle" TargetType="Expander">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border BorderBrush="#FFF0F0F0"
                                BorderThickness="1"
                                CornerRadius="6">
                            <StackPanel>
                                <ToggleButton x:Name="HeaderToggle"
                                              Content="{TemplateBinding Header}"
                                              FontSize="14"
                                              FontWeight="SemiBold"
                                              Foreground="{StaticResource MotionTextPrimaryBrush}"
                                              IsChecked="{Binding IsExpanded, Mode=TwoWay,
                                                                  RelativeSource={RelativeSource TemplatedParent}}"
                                              Focusable="False">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="HeaderChrome"
                                                    Padding="16,12"
                                                    Background="#FFFAFAFA"
                                                    CornerRadius="6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Path Width="15" Height="15" Margin="0,0,9,0"
                                                          VerticalAlignment="Center"
                                                          Stretch="Uniform"
                                                          Stroke="{StaticResource MotionTextSecondaryBrush}"
                                                          StrokeThickness="1.6"
                                                          Data="{StaticResource MotionIcon.Alarm}" />
                                                    <ContentPresenter Grid.Column="1"
                                                                      VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2"
                                                               Margin="10,0,0,0"
                                                               VerticalAlignment="Center"
                                                               Style="{StaticResource ConnectionHintStyle}"
                                                               Text="急停极性、动作码" />
                                                    <Path x:Name="HeaderChevron"
                                                          Grid.Column="3"
                                                          Width="9" Height="5"
                                                          Margin="14,0,2,0"
                                                          VerticalAlignment="Center"
                                                          RenderTransformOrigin="0.5,0.5"
                                                          Stretch="Fill"
                                                          Stroke="{StaticResource MotionTextSecondaryBrush}"
                                                          StrokeThickness="1.5"
                                                          Data="M0,0 L4.5,4.5 L9,0" />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="HeaderChrome"
                                                            Property="Background"
                                                            Value="#FFF4F6F9" />
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="HeaderChrome"
                                                            Property="CornerRadius"
                                                            Value="6,6,0,0" />
                                                    <Setter TargetName="HeaderChevron"
                                                            Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="180" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <Border x:Name="ExpandSite"
                                        Padding="16"
                                        BorderBrush="#FFF0F0F0"
                                        BorderThickness="0,1,0,0"
                                        Visibility="Collapsed">
                                    <ContentPresenter ContentSource="Content" />
                                </Border>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite"
                                        Property="Visibility"
                                        Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ConnectionMetricStyle" TargetType="Border">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource MotionBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>

        <Style x:Key="ConnectionDetailLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MotionTextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ConnectionDetailValueStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{StaticResource MotionTextPrimaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Left" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <Grid>
            <Border x:Name="MainCard"
                    MaxWidth="1280"
                    Margin="32"
                    Padding="32"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Style="{StaticResource MotionWorkspaceCardStyle}">

                <StackPanel>
                    <Border Padding="0,0,0,16"
                            BorderBrush="#FFF0F0F0"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock VerticalAlignment="Center"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource MotionTextPrimaryBrush}"
                                       Text="控制卡连接配置" />

                            <Border Grid.Column="1"
                                    Padding="12,5"
                                    CornerRadius="12">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#FFF5F5F5" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Background"
                                                        Value="{StaticResource MotionSuccessLightBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                <Setter Property="Background"
                                                        Value="{StaticResource MotionPrimaryLightBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Margin="0,0,7,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#FFD9D9D9" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                        <Setter Property="Fill"
                                                                Value="{StaticResource MotionBrush.Success}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                        <Setter Property="Fill"
                                                                Value="{StaticResource MotionBrush.Primary}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock FontSize="13">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="未连接" />
                                                <Setter Property="Foreground"
                                                        Value="{StaticResource MotionTextSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                        <Setter Property="Text" Value="已连接" />
                                                        <Setter Property="Foreground"
                                                                Value="{StaticResource MotionBrush.Success}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                        <Setter Property="Text" Value="处理中" />
                                                        <Setter Property="Foreground"
                                                                Value="{StaticResource MotionBrush.Primary}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid x:Name="FormGrid" Margin="0,24,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="FormLeftColumn" Width="*" />
                            <ColumnDefinition x:Name="FormGapColumn" Width="40" />
                            <ColumnDefinition x:Name="FormRightColumn" Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel x:Name="DriverField">
                            <TextBlock Style="{StaticResource ConnectionFieldLabelStyle}"
                                       Text="板卡驱动" />
                            <ComboBox IsEnabled="{Binding CanEditConfiguration}"
                                      ItemsSource="{Binding AvailableDriverKeys}"
                                      SelectedItem="{Binding SelectedDriverKey, Mode=TwoWay,
                                                            UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource MotionComboBoxStyle}" />
                            <TextBlock Style="{StaticResource ConnectionValidationStyle}"
                                       Text="{Binding DriverValidationMessage}" />
                        </StackPanel>

                        <StackPanel x:Name="CardNumberField" Grid.Column="2">
                            <TextBlock Style="{StaticResource ConnectionFieldLabelStyle}"
                                       Text="板卡号" />
                            <TextBox IsEnabled="{Binding CanEditConfiguration}"
                                     Text="{Binding CardNo, Mode=TwoWay,
                                                   UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MotionInputStyle}" />
                            <TextBlock Style="{StaticResource ConnectionValidationStyle}"
                                       Text="{Binding CardNoValidationMessage}" />
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="FileGrid" Margin="0,24,0,0">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLctM60Selected}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="FileLeftColumn" Width="*" />
                            <ColumnDefinition x:Name="FileGapColumn" Width="40" />
                            <ColumnDefinition x:Name="FileRightColumn" Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel x:Name="EniFileField">
                            <TextBlock Style="{StaticResource ConnectionFieldLabelStyle}"
                                       Text="EtherCAT ENI 文件" />
                            <Border Background="White"
                                    BorderBrush="{StaticResource MotionBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox IsEnabled="{Binding CanEditConfiguration}"
                                             Text="{Binding EniFilePath, Mode=TwoWay,
                                                           UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{Binding EniFilePath}"
                                             Style="{StaticResource ConnectionFileTextBoxStyle}" />
                                    <Button Grid.Column="1"
                                            Command="{Binding SelectEniFileCommand}"
                                            Style="{StaticResource ConnectionFileButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="14" Height="14"
                                                  Margin="0,0,7,0"
                                                  Stretch="Uniform"
                                                  Stroke="{Binding Foreground,
                                                                   RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.5"
                                                  Data="{StaticResource MotionIcon.Folder}" />
                                            <TextBlock Text="选择" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                            <TextBlock Style="{StaticResource ConnectionValidationStyle}"
                                       Text="{Binding EniFileValidationMessage}" />
                        </StackPanel>

                        <StackPanel x:Name="SlaveFileField" Grid.Column="2">
                            <TextBlock Style="{StaticResource ConnectionFieldLabelStyle}"
                                       Text="从站参数文件" />
                            <Border Background="White"
                                    BorderBrush="{StaticResource MotionBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox IsEnabled="{Binding CanEditConfiguration}"
                                             Text="{Binding SlaveParameterFilePath, Mode=TwoWay,
                                                           UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{Binding SlaveParameterFilePath}"
                                             Style="{StaticResource ConnectionFileTextBoxStyle}" />
                                    <Button Grid.Column="1"
                                            Command="{Binding SelectSlaveParameterFileCommand}"
                                            Style="{StaticResource ConnectionFileButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="14" Height="14"
                                                  Margin="0,0,7,0"
                                                  Stretch="Uniform"
                                                  Stroke="{Binding Foreground,
                                                                   RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.5"
                                                  Data="{StaticResource MotionIcon.Folder}" />
                                            <TextBlock Text="选择" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                            <TextBlock Style="{StaticResource ConnectionValidationStyle}"
                                       Text="{Binding SlaveParameterFileValidationMessage}" />
                        </StackPanel>
                    </Grid>

                    <Expander x:Name="AdvancedExpander"
                              Margin="0,24,0,0"
                              Header="高级设置"
                              IsExpanded="False">
                        <Expander.Style>
                            <Style TargetType="Expander"
                                   BasedOn="{StaticResource ConnectionAdvancedExpanderStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLctM60Selected}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Expander.Style>
                        <Grid x:Name="AdvancedGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="AdvancedLeftColumn" Width="*" />
                                <ColumnDefinition x:Name="AdvancedGapColumn" Width="24" />
                                <ColumnDefinition x:Name="AdvancedRightColumn" Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel x:Name="EmergencyPolarityField">
                                <TextBlock Style="{StaticResource ConnectionFieldLabelStyle}"
                                           Text="急停输入极性" />
                                <ComboBox IsEnabled="{Binding CanEditConfiguration}"
                                          ItemsSource="{Binding EmergencyPolarityOptions}"
                                          DisplayMemberPath="Value"
                                          SelectedValuePath="Key"
                                          SelectedValue="{Binding EmergencyInputInverted, Mode=TwoWay,
                                                                  UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource MotionComboBoxStyle}" />
                                <TextBlock Style="{StaticResource ConnectionValidationStyle}"
                                           Text="{Binding EmergencyInputValidationMessage}" />
                            </StackPanel>

                            <StackPanel x:Name="EmergencyActionField" Grid.Column="2">
                                <TextBlock Style="{StaticResource ConnectionFieldLabelStyle}"
                                           Text="急停动作码（0–255）" />
                                <TextBox IsEnabled="{Binding CanEditConfiguration}"
                                         Text="{Binding EmergencyAction, Mode=TwoWay,
                                                       UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MotionInputStyle}" />
                                <TextBlock Style="{StaticResource ConnectionValidationStyle}"
                                           Text="{Binding EmergencyActionValidationMessage}" />
                                <TextBlock Margin="0,5,0,0"
                                           Style="{StaticResource ConnectionHintStyle}"
                                           Text="动作码含义请以凌臣 M60 手册为准。" />
                            </StackPanel>
                        </Grid>
                    </Expander>

                    <Border Margin="0,24,0,0"
                            Padding="16,11"
                            Background="{StaticResource MotionPrimaryLightBrush}"
                            BorderBrush="#FF91CAFF"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Width="16" Height="16"
                                  Margin="0,0,9,0"
                                  VerticalAlignment="Center"
                                  Stretch="Uniform"
                                  Stroke="{StaticResource MotionBrush.Primary}"
                                  StrokeThickness="1.6"
                                  Data="{StaticResource MotionIcon.Info}" />
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       FontSize="13"
                                       Foreground="{StaticResource MotionBrush.Primary}"
                                       TextWrapping="Wrap"
                                       Text="请确保当前 Driver、ENI 网络和 M60 从站参数与现场硬件一致。配置修改仅在未连接时可用。" />
                        </Grid>
                    </Border>

                    <Grid x:Name="FooterGrid" Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="FooterActionsColumn" Width="Auto" />
                            <ColumnDefinition x:Name="FooterGapColumn" Width="24" />
                            <ColumnDefinition x:Name="FooterStatusColumn" Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.ColumnSpan="3"
                                BorderBrush="#FFF0F0F0"
                                BorderThickness="0,1,0,0" />

                        <WrapPanel x:Name="ActionPanel"
                                   Grid.Row="1"
                                   Margin="0,20,0,0"
                                   VerticalAlignment="Center">
                            <Button Command="{Binding SaveConfigurationCommand}"
                                    Style="{StaticResource MotionSecondaryButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="14" Height="14"
                                          Margin="0,0,7,0"
                                          Stretch="Uniform"
                                          Stroke="{Binding Foreground,
                                                           RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.5"
                                          Data="{StaticResource MotionIcon.Save}" />
                                    <TextBlock Text="保存配置" />
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding ScanCommand}"
                                    Style="{StaticResource MotionSecondaryButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="14" Height="14"
                                          Margin="0,0,7,0"
                                          Stretch="Uniform"
                                          Stroke="{Binding Foreground,
                                                           RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.5"
                                          Data="{StaticResource MotionIcon.Refresh}" />
                                    <TextBlock Text="扫描轴" />
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding ConnectCommand}">
                                <Button.Style>
                                    <Style TargetType="Button"
                                           BasedOn="{StaticResource MotionPrimaryButton}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="14" Height="14"
                                          Margin="0,0,7,0"
                                          Stretch="Uniform"
                                          Stroke="White"
                                          StrokeThickness="1.5"
                                          Data="{StaticResource MotionIcon.Connection}" />
                                    <TextBlock Text="连接" />
                                </StackPanel>
                            </Button>

                            <Button Margin="0"
                                    Command="{Binding DisconnectCommand}">
                                <Button.Style>
                                    <Style TargetType="Button"
                                           BasedOn="{StaticResource MotionDangerOutlineButton}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="14" Height="14"
                                          Margin="0,0,7,0"
                                          Stretch="Uniform"
                                          Stroke="{Binding Foreground,
                                                           RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.5"
                                          Data="{StaticResource MotionIcon.Connection}" />
                                    <TextBlock Text="断开" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>

                        <Border x:Name="StatusPanel"
                                Grid.Row="1"
                                Grid.Column="2"
                                Margin="0,20,0,0"
                                Padding="16"
                                VerticalAlignment="Center"
                                Background="#FFFAFAFA"
                                BorderBrush="#FFF0F0F0"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Grid x:Name="StatusPanelGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="StatusIdentityColumn" Width="Auto" />
                                    <ColumnDefinition x:Name="StatusLeftGapColumn" Width="18" />
                                    <ColumnDefinition x:Name="StatusMetricsColumn" Width="Auto" />
                                    <ColumnDefinition x:Name="StatusMiddleGapColumn" Width="18" />
                                    <ColumnDefinition x:Name="StatusDetailsColumn" Width="*" />
                                    <ColumnDefinition x:Name="StatusRightGapColumn" Width="18" />
                                    <ColumnDefinition x:Name="StatusResultColumn" Width="1.3*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border x:Name="StatusLeftSeparator"
                                        Grid.Column="1"
                                        BorderBrush="#FFE8E8E8"
                                        BorderThickness="1,0,0,0" />
                                <Border x:Name="StatusMiddleSeparator"
                                        Grid.Column="3"
                                        BorderBrush="#FFE8E8E8"
                                        BorderThickness="1,0,0,0" />
                                <Border x:Name="StatusRightSeparator"
                                        Grid.Column="5"
                                        BorderBrush="#FFE8E8E8"
                                        BorderThickness="1,0,0,0" />

                                <StackPanel x:Name="StatusIdentityPanel"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <Path Width="22" Height="22"
                                          HorizontalAlignment="Center"
                                          Stretch="Uniform"
                                          StrokeThickness="1.7"
                                          Data="{StaticResource MotionIcon.Card}">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Stroke"
                                                        Value="{StaticResource MotionTextSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                        <Setter Property="Stroke"
                                                                Value="{StaticResource MotionBrush.Success}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                        <Setter Property="Stroke"
                                                                Value="{StaticResource MotionBrush.Primary}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                    <TextBlock Margin="0,5,0,0"
                                               HorizontalAlignment="Center"
                                               FontSize="14"
                                               FontWeight="Medium">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="等待连接" />
                                                <Setter Property="Foreground"
                                                        Value="{StaticResource MotionTextPrimaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                        <Setter Property="Text" Value="运行中" />
                                                        <Setter Property="Foreground"
                                                                Value="{StaticResource MotionBrush.Success}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                        <Setter Property="Text" Value="处理中" />
                                                        <Setter Property="Foreground"
                                                                Value="{StaticResource MotionBrush.Primary}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Margin="0,3,0,0"
                                               HorizontalAlignment="Center"
                                               Style="{StaticResource ConnectionHintStyle}"
                                               Text="运动控制卡" />
                                </StackPanel>

                                <UniformGrid x:Name="StatusMetricsPanel"
                                             Grid.Column="2"
                                             VerticalAlignment="Center"
                                             Columns="3">
                                    <StackPanel Margin="0,0,8,0">
                                        <Border Style="{StaticResource ConnectionMetricStyle}">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource MotionTextPrimaryBrush}"
                                                       Text="{Binding AxisCount}" />
                                        </Border>
                                        <TextBlock HorizontalAlignment="Center"
                                                   Style="{StaticResource ConnectionHintStyle}"
                                                   Text="轴" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,0">
                                        <Border Style="{StaticResource ConnectionMetricStyle}">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource MotionTextPrimaryBrush}"
                                                       Text="{Binding DiCount}" />
                                        </Border>
                                        <TextBlock HorizontalAlignment="Center"
                                                   Style="{StaticResource ConnectionHintStyle}"
                                                   Text="DI" />
                                    </StackPanel>
                                    <StackPanel>
                                        <Border Margin="0"
                                                Style="{StaticResource ConnectionMetricStyle}">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource MotionTextPrimaryBrush}"
                                                       Text="{Binding DoCount}" />
                                        </Border>
                                        <TextBlock HorizontalAlignment="Center"
                                                   Style="{StaticResource ConnectionHintStyle}"
                                                   Text="DO" />
                                    </StackPanel>
                                </UniformGrid>

                                <Grid x:Name="StatusDetailsPanel"
                                      Grid.Column="4"
                                      MinWidth="140"
                                      VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="22" />
                                        <RowDefinition Height="22" />
                                        <RowDefinition Height="22" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Style="{StaticResource ConnectionDetailLabelStyle}"
                                               Text="配置驱动" />
                                    <TextBlock Grid.Column="1"
                                               Style="{StaticResource ConnectionDetailValueStyle}"
                                               Text="{Binding SelectedDriverKey}" />

                                    <TextBlock Grid.Row="1"
                                               Style="{StaticResource ConnectionDetailLabelStyle}"
                                               Text="实际驱动" />
                                    <TextBlock Grid.Row="1" Grid.Column="1">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock"
                                                   BasedOn="{StaticResource ConnectionDetailValueStyle}">
                                                <Setter Property="Text" Value="—" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                        <Setter Property="Text"
                                                                Value="{Binding DriverKey}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock Grid.Row="2"
                                               Style="{StaticResource ConnectionDetailLabelStyle}"
                                               Text="固件版本" />
                                    <TextBlock Grid.Row="2" Grid.Column="1">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock"
                                                   BasedOn="{StaticResource ConnectionDetailValueStyle}">
                                                <Setter Property="Text" Value="—" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                        <Setter Property="Text"
                                                                Value="{Binding FirmwareVersion}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <Border x:Name="StatusResultPanel"
                                        Grid.Column="6"
                                        MinWidth="180"
                                        Padding="13,11"
                                        VerticalAlignment="Center"
                                        CornerRadius="6">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background"
                                                    Value="{StaticResource MotionPrimaryLightBrush}" />
                                            <Setter Property="BorderBrush" Value="#FF91CAFF" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                    <Setter Property="Background"
                                                            Value="{StaticResource MotionSuccessLightBrush}" />
                                                    <Setter Property="BorderBrush" Value="#FFB7EB8F" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Path Width="16" Height="16"
                                              Margin="0,0,8,0"
                                              VerticalAlignment="Top"
                                              Stretch="Uniform"
                                              StrokeThickness="1.6"
                                              Data="{StaticResource MotionIcon.Info}">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Stroke"
                                                            Value="{StaticResource MotionBrush.Primary}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                            <Setter Property="Stroke"
                                                                    Value="{StaticResource MotionBrush.Success}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                        <TextBlock Grid.Column="1"
                                                   FontSize="12"
                                                   Foreground="{StaticResource MotionTextPrimaryBrush}"
                                                   Text="{Binding StatusMessage}"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
