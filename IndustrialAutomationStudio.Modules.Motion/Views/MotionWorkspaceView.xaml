<UserControl x:Class="IndustrialAutomationStudio.Modules.Motion.Views.MotionWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <UserControl.Resources>
        <ResourceDictionary Source="/IndustrialAutomationStudio.Modules.Motion;component/Resources/MotionTheme.xaml" />
    </UserControl.Resources>

    <Grid Background="{StaticResource MotionBrush.Background}">
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="54" />
            <RowDefinition Height="*" />
            <RowDefinition Height="{DynamicResource MotionStatusBarHeight}" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource MotionBrush.Navigation}"
                BorderBrush="{StaticResource MotionBorderBrush}"
                BorderThickness="0,0,0,1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <ItemsControl Margin="12,0"
                              ItemsSource="{Binding NavigationItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton IsChecked="{Binding IsActive, Mode=OneWay}"
                                          Command="{Binding Command}"
                                          Style="{StaticResource MotionWorkspaceTopNavigationStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="16"
                                          Height="16"
                                          VerticalAlignment="Center"
                                          Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                          StrokeThickness="1.45"
                                          Data="{Binding IconKey, Converter={StaticResource MotionResourceKeyToGeometryConverter}}" />
                                    <TextBlock Margin="7,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Text="{Binding Title}" />
                                </StackPanel>
                            </ToggleButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="1"
                Padding="22,8"
                Background="{StaticResource MotionCardBackgroundBrush}"
                BorderBrush="{StaticResource MotionBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="11"
                               Foreground="{StaticResource MotionTextSecondaryBrush}"
                               Text="可嵌入运控工作区" />
                    <TextBlock Margin="0,2,0,0"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource MotionTextPrimaryBrush}"
                               Text="{Binding ActivePageTitle}" />
                </StackPanel>
                <Border Grid.Column="1"
                        Padding="10,5"
                        VerticalAlignment="Center"
                        Background="{StaticResource MotionPrimaryLightBrush}"
                        CornerRadius="4">
                    <TextBlock Foreground="{StaticResource MotionBrush.Primary}"
                               Text="{Binding DriverLabel}" />
                </Border>
            </Grid>
        </Border>

        <ContentControl x:Name="WorkspaceContent"
                        Grid.Row="2"
                        Margin="22,18" />

        <Border Grid.Row="3"
                Background="{StaticResource MotionBrush.Navigation}"
                BorderBrush="{StaticResource MotionBorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Ellipse Width="7"
                             Height="7"
                             Fill="{StaticResource MotionBrush.Success}" />
                    <TextBlock Margin="7,0,0,0"
                               FontSize="11"
                               Foreground="{StaticResource MotionTextSecondaryBrush}"
                               Text="工作区就绪" />
                </StackPanel>
                <Border Grid.Column="1"
                        Width="1"
                        Height="14"
                        HorizontalAlignment="Center"
                        Background="{StaticResource MotionBorderBrush}" />
                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{StaticResource MotionTextSecondaryBrush}"
                           Text="{Binding ActivePageTitle}" />
                <TextBlock Grid.Column="4"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{StaticResource MotionTextSecondaryBrush}"
                           Text="{Binding VersionText}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
