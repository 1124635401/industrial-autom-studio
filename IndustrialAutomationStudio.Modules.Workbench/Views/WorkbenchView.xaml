<UserControl x:Class="IndustrialAutomationStudio.Modules.Workbench.Views.WorkbenchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="Transparent">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <ItemsControl ItemsSource="{Binding StatusCards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="5" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border MinHeight="130"
                                Margin="0,0,12,14"
                                Padding="16"
                                Style="{StaticResource ShellCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="40"
                                        Height="40"
                                        VerticalAlignment="Top"
                                        Background="{StaticResource ShellBrush.PrimaryLight}"
                                        CornerRadius="8">
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource ShellBrush.Primary}"
                                               Text="{Binding BadgeText}" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock FontSize="14"
                                               FontWeight="SemiBold"
                                               Text="{Binding Title}" />
                                    <TextBlock Margin="0,11,0,0"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource ShellBrush.Warning}"
                                               Text="{Binding StatusText}" />
                                    <TextBlock Margin="0,5,0,0"
                                               FontSize="10"
                                               Foreground="{StaticResource ShellBrush.AuxiliaryText}"
                                               Text="{Binding Description}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="0.85*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <ItemsControl Grid.ColumnSpan="5"
                              ItemsSource="{Binding OverviewSections}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Height="260"
                                    Margin="0,0,12,0"
                                    Padding="18"
                                    Style="{StaticResource ShellCardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock FontSize="16"
                                               FontWeight="SemiBold"
                                               Text="{Binding Title}" />
                                    <StackPanel Grid.Row="1"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <Border Width="54"
                                                Height="54"
                                                HorizontalAlignment="Center"
                                                Background="{StaticResource ShellBrush.PrimaryLight}"
                                                CornerRadius="14">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource ShellBrush.Primary}"
                                                       Text="{Binding BadgeText}" />
                                        </Border>
                                        <TextBlock Margin="0,16,0,0"
                                                   HorizontalAlignment="Center"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource ShellBrush.Warning}"
                                                   Text="{Binding StatusText}" />
                                        <TextBlock Margin="0,7,0,0"
                                                   MaxWidth="260"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource ShellBrush.AuxiliaryText}"
                                                   Text="{Binding Description}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        MinHeight="190"
                        Padding="18"
                        Style="{StaticResource ShellCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="快捷入口" />
                        <ItemsControl Grid.Row="1"
                                      Margin="0,20,0,0"
                                      ItemsSource="{Binding QuickEntries}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Padding="5"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Command="{Binding DataContext.NavigateShortcutCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel>
                                            <Border Width="44"
                                                    Height="44"
                                                    HorizontalAlignment="Center"
                                                    Background="{StaticResource ShellBrush.PrimaryLight}"
                                                    CornerRadius="9">
                                                <TextBlock HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource ShellBrush.Primary}"
                                                           Text="{Binding BadgeText}" />
                                            </Border>
                                            <TextBlock Margin="0,8,0,0"
                                                       HorizontalAlignment="Center"
                                                       FontSize="11"
                                                       Text="{Binding Title}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <ItemsControl Grid.Column="2"
                              Grid.ColumnSpan="3"
                              ItemsSource="{Binding RecentSections}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border MinHeight="190"
                                    Margin="0,0,12,0"
                                    Padding="18"
                                    Style="{StaticResource ShellCardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock FontSize="16"
                                               FontWeight="SemiBold"
                                               Text="{Binding Title}" />
                                    <StackPanel Grid.Row="1"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <TextBlock HorizontalAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource ShellBrush.Warning}"
                                                   Text="{Binding StatusText}" />
                                        <TextBlock Margin="0,7,0,0"
                                                   TextAlignment="Center"
                                                   Foreground="{StaticResource ShellBrush.AuxiliaryText}"
                                                   Text="{Binding Description}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
